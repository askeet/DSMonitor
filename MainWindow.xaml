<Window x:Class="DSMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DSMonitor.Converters"
        mc:Ignorable="d"
        Title="DSMonitor"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E13"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B0E13" />
        <SolidColorBrush x:Key="Surface" Color="#12161D" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#171C25" />
        <SolidColorBrush x:Key="Inset" Color="#0D1117" />
        <SolidColorBrush x:Key="BorderBrush" Color="#252D3A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#1C2330" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA5B5" />
        <SolidColorBrush x:Key="TextMuted" Color="#6F7A8A" />
        <SolidColorBrush x:Key="Accent" Color="#4F8DF7" />
        <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#16A34A" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:MonitoringStateToBrushConverter x:Key="MonitoringStateBrush" />
        <converters:ForgeStatusToBrushConverter x:Key="ForgeStatusBrush" />
        <converters:EventSeverityToBrushConverter x:Key="SeverityBrush" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
            <Setter Property="Foreground" Value="#06130B" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#354052" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="JobCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="JobHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ActivitySpinner" TargetType="ContentControl">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Ellipse x:Name="SpinnerRing"
                                 Width="10"
                                 Height="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stroke="{StaticResource AccentGreen}"
                                 StrokeThickness="2"
                                 StrokeDashArray="2.5 1.5"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="ActivitySpinStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRing"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:0.9"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="ActivitySpinStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ReportedStatusCellTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ReportedStatusSpinner"
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource ActivitySpinner}"
                                ToolTip="Job-scoped activity/lifecycle evidence; not proof of worker liveness."
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ReportedStatusCellText}"
                           Style="{StaticResource JobCellText}"
                           ToolTip="{Binding ReportedStatusCellTooltip}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LiveActivityHistoryStatusCellTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="LiveActivityHistorySpinner"
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource ActivitySpinner}"
                                ToolTip="Current activity for an explicitly RUNNING Forge job; not proof of worker liveness."
                                Visibility="{Binding IsCurrentActiveTarget, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ReportedStatusText}"
                           Style="{StaticResource JobCellText}"
                           ToolTip="{Binding ReportedStatusTooltip}" />
            </Grid>
        </DataTemplate>


        <Style x:Key="JobColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0,3,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="JobsGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#0F131A" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="ColumnHeaderHeight" Value="28" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0,3,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#181E27" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1B2636" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0,3,0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveActivityHistoryGrid" TargetType="DataGrid"
               BasedOn="{StaticResource JobsGrid}">
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SelectionBar"
                                    Height="2"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource Accent}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4E5868" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          HorizontalAlignment="Left" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="0,14,0,0"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimelineItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#354052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0B0F15" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3E4C60"
                                                        CornerRadius="4"
                                                        Margin="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="10" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="#162033" BorderBrush="#263752" BorderThickness="1">
                    <Viewbox Width="24" Height="24">
                        <Path Data="M3,5 H21 V17 H3 Z M9,21 H15 M12,17 V21"
                              Stroke="{StaticResource Accent}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent" />
                    </Viewbox>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DSMonitor"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Forge Delegate &amp; OpenCode Activity · strictly read-only"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Margin="24,0"
                    Padding="13,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="#11161D"
                    BorderBrush="{Binding MonitoringState, Converter={StaticResource MonitoringStateBrush}}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Margin="0,0,8,0"
                             Fill="{Binding MonitoringState, Converter={StaticResource MonitoringStateBrush}}" />
                    <TextBlock Text="{Binding MonitoringStateText}"
                               Foreground="{Binding MonitoringState, Converter={StaticResource MonitoringStateBrush}}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateDetail}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11.5"
                               Margin="10,0,0,0"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeText}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LastRefreshText, StringFormat='Refresh {0}'}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10.5"
                               HorizontalAlignment="Right" />
                </StackPanel>
                <Button Content="▶  Start Monitoring"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Stop"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding StopCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Settings"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        ToolTip="Settings are planned for Phase 4." />
            </StackPanel>
        </Grid>

        <!-- Summary cards -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Confirmed running or blocked" Style="{StaticResource CardSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                <StackPanel>
                    <TextBlock Text="COMPLETED" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Completion reported by metadata" Style="{StaticResource CardSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                <StackPanel>
                    <TextBlock Text="FAILED / TIMED OUT" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding FailedCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="Actual reported failures" Style="{StaticResource CardSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                <StackPanel>
                    <TextBlock Text="TOTAL OBSERVED" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="{Binding UnknownDetailText}" Style="{StaticResource CardSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="OBSERVED COST" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding CostText}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="{Binding CostDetailText}" Style="{StaticResource CardSub}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Jobs and details -->
        <Grid Grid.Row="2" Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*" MinWidth="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="54*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Forge jobs" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Metadata and logs from the local forge runs directory"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding JobsSummaryText}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="18,0,18,10"
                            Padding="10,7"
                            CornerRadius="8"
                            Background="{StaticResource Inset}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="12" Height="12"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8"
                                         Stroke="{StaticResource TextMuted}"
                                         StrokeThickness="1.3"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />
                                <Line X1="7" Y1="7" X2="11" Y2="11"
                                      Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SearchTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by job, project, model, status, or session." />
                            <TextBlock Grid.Column="1"
                                       Text="Search jobs, projects, models, sessions…"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="JobsDataGrid"
                                  Style="{StaticResource JobsGrid}"
                                  ItemsSource="{Binding JobsView}"
                                  SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                  Margin="5,0,5,0"
                                  AutomationProperties.Name="Forge jobs">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Project"
                                                        Width="90"
                                                        MinWidth="72"
                                                        SortMemberPath="ProjectText"
                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProjectText}"
                                                       Style="{StaticResource JobCellText}"
                                                       ToolTip="{Binding ProjectTooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Started"
                                                    Binding="{Binding StartedText}"
                                                    Width="96"
                                                    ElementStyle="{StaticResource JobCellText}"
                                                    HeaderStyle="{StaticResource JobColumnHeaderStyle}" />

                                <DataGridTemplateColumn Header="Duration"
                                                        Width="78"
                                                        SortMemberPath="DurationSortSeconds"
                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationText}"
                                                       Style="{StaticResource JobCellText}"
                                                       ToolTip="{Binding DurationTooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Job"
                                                        Width="50"
                                                        SortMemberPath="JobId"
                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JobDisplayText}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding JobId}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Reported Status"
                                                        Width="*"
                                                        SortMemberPath="ReportedStatusText"
                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}"
                                                        CellTemplate="{StaticResource ReportedStatusCellTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="30"
                                    Visibility="{Binding IsJobsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Viewbox Width="40" Height="34" HorizontalAlignment="Center">
                                <Path Data="M3,6 H21 V18 H3 Z M7,10 H17 M7,14 H13"
                                      Stroke="#465268"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Viewbox>
                            <TextBlock Text="{Binding JobsEmptyText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="DSMonitor never starts, stops, or prompts a worker."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="10.5"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,1,0,0"
                            Padding="18,9">
                        <TextBlock Text="Read-only observer · forge-delegate jobs are never modified"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,16,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedJob.JobId}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Margin="10,0,0,0"
                                            Padding="8,3"
                                            CornerRadius="9"
                                            Background="#11161D"
                                            BorderBrush="{Binding SelectedJob.Snapshot.Status, Converter={StaticResource ForgeStatusBrush}}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedJob.StatusText}"
                                                   Foreground="{Binding SelectedJob.Snapshot.Status, Converter={StaticResource ForgeStatusBrush}}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedJob.ProjectTooltip}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedJob.ProjectTooltip}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding SelectedJob.ModelText}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10.5" />
                                    <TextBlock Text="  ·  " Foreground="#3E495A" FontSize="10.5" />
                                    <TextBlock Text="{Binding SelectedJob.SessionText}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedJobElapsedText"
                                           Text="{Binding SelectedJob.ElapsedText}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="SelectedJobElapsedLabel"
                                           Text="elapsed / observed span"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="10"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <TabControl x:Name="SelectedJobTabs"
                                    Grid.Row="1"
                                    Style="{StaticResource DashboardTabControl}"
                                    Margin="20,0,20,16"
                                    DataContext="{Binding SelectedJob}">
                            <TabItem Header="Live Activity" Style="{StaticResource TabItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Original Request"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6" />

                                    <TextBox x:Name="OriginalRequestTextBox"
                                             Grid.Row="1"
                                             Text="{Binding OriginalRequestText, Mode=OneWay}"
                                             ToolTip="{Binding OriginalRequestAttributionText}"
                                             AutomationProperties.HelpText="{Binding OriginalRequestAttributionText}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="56"
                                             MaxHeight="88"
                                             Background="#0F141B"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderSoft}"
                                             BorderThickness="1"
                                             Padding="8"
                                             Margin="0,0,0,10"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="11.5"
                                             AutomationProperties.Name="Original request" />

                                    <Grid Grid.Row="2" Margin="0,0,0,6">
                                        <TextBlock Text="Activity History"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <ContentControl HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource ActivitySpinner}"
                                                        ToolTip="Job-scoped activity/lifecycle evidence; not proof of worker liveness."
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <DataGrid x:Name="LiveActivityHistoryGrid"
                                                  Style="{StaticResource LiveActivityHistoryGrid}"
                                                  ItemsSource="{Binding LiveActivityHistory}"
                                                  SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                                                  MinHeight="120"
                                                  AutomationProperties.Name="Live activity history">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Started"
                                                                        Width="150"
                                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StartedText}"
                                                                       Style="{StaticResource JobCellText}"
                                                                       ToolTip="{Binding StartedTooltip}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Duration"
                                                                        Width="90"
                                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DurationText}"
                                                                       Style="{StaticResource JobCellText}"
                                                                       ToolTip="{Binding DurationTooltip}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Reported Status"
                                                                        Width="*"
                                                                        HeaderStyle="{StaticResource JobColumnHeaderStyle}"
                                                                        CellTemplate="{StaticResource LiveActivityHistoryStatusCellTemplate}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="{Binding LiveActivityHistoryEmptyText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="330"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLiveActivityHistory}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Selected Message"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SelectedActivityCompletenessText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SelectedActivityTextIsComplete, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>

                                    <TextBox x:Name="SelectedActivityTextBox"
                                             Grid.Row="5"
                                             Text="{Binding SelectedActivityText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="64"
                                             Background="#0F141B"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderSoft}"
                                             BorderThickness="1"
                                             Padding="8"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="11.5"
                                             AutomationProperties.Name="Selected message" />
                                </Grid>
                            </TabItem>

                            <TabItem Header="Overview" Style="{StaticResource TabItemStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,14,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Job ID" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding JobId}" Style="{StaticResource DetailValue}"
                                                       FontFamily="Cascadia Mono, Consolas" />

                                            <TextBlock Grid.Row="1" Text="OpenCode session" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SessionText}" Style="{StaticResource DetailValue}"
                                                       FontFamily="Cascadia Mono, Consolas" />

                                            <TextBlock Grid.Row="2" Text="Project path" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedJobProjectPath" Text="{Binding ProjectTooltip}" Style="{StaticResource DetailValue}" />

                                            <TextBlock Grid.Row="3" Text="Model / agent" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource DetailValue}" />

                                            <TextBlock Grid.Row="4" Text="Started" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StartedText}" Style="{StaticResource DetailValue}" />

                                            <TextBlock Grid.Row="5" Text="Forge status" Style="{StaticResource DetailLabel}" />
                                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding Snapshot.Status, Converter={StaticResource ForgeStatusBrush}}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ForgeStatusLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10.5"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="6" Text="Last activity" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastActivityText}" Style="{StaticResource DetailValue}" />

                                            <TextBlock Grid.Row="7" Text="Observed events" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding EventCountText}" Style="{StaticResource DetailValue}" />
                                        </Grid>

                                        <Border Background="#0F141B"
                                                BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="12"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="FORGE DEADLINE"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DeadlineText}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="12"
                                                           Margin="0,4,0,2" />
                                                <TextBlock Text="{Binding DeadlineDetail}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#101A14"
                                                BorderBrush="#1F3A2A"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="12"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="PARSING / SOURCE WARNINGS"
                                                           Foreground="#8AD3A6"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WarningsText}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Forge 1.2.4 does not always report job status. Missing status is shown as UNKNOWN; PID liveness and elapsed deadlines are not treated as proof of execution or termination."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   LineHeight="15" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Timeline" Style="{StaticResource TabItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Observed events"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Newest first · safe summaries"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10.5"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding RecentEvents}"
                                             ItemContainerStyle="{StaticResource TimelineItemStyle}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E1218"
                                                        BorderBrush="{StaticResource BorderSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        ToolTip="{Binding TimestampTooltip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimestampText}"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center" />
                                                        <Ellipse Grid.Column="1"
                                                                 Width="6" Height="6"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CategoryText}"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   FontSize="10"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Summary}"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Tool Activity" Style="{StaticResource TabItemStyle}" IsEnabled="False">
                                <StackPanel Margin="12,16">
                                    <TextBlock Text="Tool activity details arrive in Phase 2."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="Phase 1 reads tool summaries from forge JSONL events only."
                                               Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,6,0,0" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Tests" Style="{StaticResource TabItemStyle}" IsEnabled="False">
                                <StackPanel Margin="12,16">
                                    <TextBlock Text="Test activity arrives in Phase 2."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                    <TextBlock Text="No test result is fabricated from log silence."
                                               Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="0,6,0,0" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Files" Style="{StaticResource TabItemStyle}" IsEnabled="False">
                                <StackPanel Margin="12,16">
                                    <TextBlock Text="File activity details arrive in Phase 2."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Raw Log" Style="{StaticResource TabItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Runtime preview · bounded to 64 KB · never copied into monitoring logs"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               Margin="0,0,0,8" />
                                    <Grid Grid.Row="1">
                                        <TextBox Text="{Binding RawLogText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="#080B10"
                                                 Foreground="#AEB9C9"
                                                 BorderBrush="{StaticResource BorderSoft}"
                                                 BorderThickness="1"
                                                 Padding="10"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="10.5"
                                                 TextWrapping="NoWrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <TextBlock Text="No raw log content is available for this job yet."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding HasRawLog, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="40"
                                Visibility="{Binding IsSelectionEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Viewbox Width="42" Height="36" HorizontalAlignment="Center">
                            <Path Data="M3,4 H21 V20 H3 Z M7,9 H17 M7,13 H17 M7,17 H13"
                                  Stroke="#465268"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                        <TextBlock Text="Select a forge job"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Metadata, observed events, and a bounded raw-log preview appear here."
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="310"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="#090C11"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                             Fill="{Binding MonitoringState, Converter={StaticResource MonitoringStateBrush}}" />
                    <TextBlock Text="{Binding MonitoringStateText}"
                               Foreground="{Binding MonitoringState, Converter={StaticResource MonitoringStateBrush}}"
                               FontSize="10.5"
                               FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="•" Foreground="#394354" Margin="10,0" FontSize="10.5" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Forge" Foreground="{StaticResource TextMuted}" FontSize="10.5" />
                    <TextBlock Text="{Binding ForgeDirectoryText}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="5,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="•" Foreground="#394354" Margin="10,0" FontSize="10.5" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OpenCode" Foreground="{StaticResource TextMuted}" FontSize="10.5" />
                    <TextBlock Text="{Binding OpenCodeStateText}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="5,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="•" Foreground="#394354" Margin="10,0" FontSize="10.5" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Refresh" Foreground="{StaticResource TextMuted}" FontSize="10.5" />
                    <TextBlock Text="{Binding RefreshIntervalText}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="5,0,0,0" />
                    <TextBlock Text="·  Last observation" Foreground="{StaticResource TextMuted}" FontSize="10.5" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding LastSuccessfulObservationText}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="5,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="7"
                           Text="{Binding WarningsText}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="10"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding WarningsText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
